---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="py-10" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site footer</h2>
  <div class="container-page">
    <div class="flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <a href="#top" class="display monogram text-[1.8rem] text-text" aria-label="Daniel Hunt — home">
        <span class="monogram-brace">{'{'}</span><span>D</span><span class="monogram-brace">{'}'}</span>
      </a>
      <div class="flex flex-col gap-3 text-left sm:text-right">
        <p class="mono-value">&copy; {year} · {SITE.name.toUpperCase()}</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2 sm:justify-end">
          <a href="#about" class="mono-value link-cinema">About</a>
          <a href="#contact" class="mono-value link-cinema">Contact</a>
          <a href={`${import.meta.env.BASE_URL}brand`} class="mono-value link-cinema">Brand</a>
        </div>
      </div>
    </div>
  </div>
</footer>
