---
import { SITE } from '../data/site';
---
<section id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-[12rem_minmax(0,48rem)]">
      <p class="mono-label">Contact</p>
      <div>
        <h2 id="contact-heading" class="display text-[clamp(2.2rem,5vw,4.25rem)] text-text">
          Send a note.
        </h2>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">
          Questions, product ideas, possible collaborations, or a conversation worth having.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={`mailto:${SITE.email}`} class="editorial-link">{SITE.email}</a>
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer me" class="editorial-link">LinkedIn</a>
          <a href={SITE.socials.x} target="_blank" rel="noopener noreferrer me" class="editorial-link">X / Twitter</a>
        </div>
      </div>
    </div>
  </div>
</section>
