---
import { SITE } from '../data/site';
---
<section id="top" class="border-b border-line" aria-labelledby="hero-heading">
  <div class="container-page">
    <div class="grid min-h-[calc(100vh-5rem)] items-center gap-12 py-14 sm:py-18 lg:grid-cols-[minmax(0,0.9fr)_minmax(18rem,0.55fr)] lg:gap-20 lg:py-20">
      <div class="max-w-3xl">
        <p class="mono-label">{SITE.name}</p>
        <h1
          id="hero-heading"
          class="display mt-6 text-[clamp(2.5rem,7vw,5.5rem)] text-text"
        >
          Built in Public. Lived offline.
        </h1>
        <p class="mt-8 max-w-2xl text-[1.35rem] font-light leading-[1.6] text-muted">
          Tech, culture, and movement.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={`mailto:${SITE.email}`} class="editorial-link">Email</a>
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer me" class="editorial-link">LinkedIn</a>
          <a href={SITE.socials.x} target="_blank" rel="noopener noreferrer me" class="editorial-link">X / Twitter</a>
        </div>
      </div>

      <figure>
        <img
          src={`${import.meta.env.BASE_URL}images/daniel-hunt-headshot.jpeg`}
          alt="Portrait of Daniel Hunt"
          class="aspect-[4/5] w-full max-w-[28rem] object-cover object-[50%_24%] grayscale-[8%] lg:ml-auto"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>
