---
import { SITE } from '../data/site';
---
<section id="top" class="border-b border-line" aria-labelledby="hero-heading">
  <div class="container-page">
    <div class="flex min-h-[calc(100vh-5rem)] flex-col justify-center py-14 sm:py-18 lg:py-20">
      <div class="max-w-5xl">
        <h1
          id="hero-heading"
          class="wordmark text-[clamp(2.75rem,11vw,8.5rem)] text-text"
        >
          {SITE.name}
        </h1>

        <p class="display mt-10 max-w-3xl text-[clamp(1.5rem,3vw,2.5rem)] text-text">
          Build in public. Live offline.
        </p>
        <p class="mt-3 max-w-3xl text-[clamp(1rem,1.5vw,1.2rem)] text-muted">
          Tech, movement, and culture.
        </p>

        <dl class="mt-12 grid max-w-2xl gap-x-8 gap-y-3 text-base sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="mono-label">Currently building</dt>
          <dd class="text-text">Datavial &middot; Life Sciences SaaS</dd>
          <dt class="mono-label">Currently in</dt>
          <dd class="text-text">{SITE.location}</dd>
        </dl>

        <div class="mt-12 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={`mailto:${SITE.email}`} class="editorial-link">Email</a>
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer me" class="editorial-link">LinkedIn</a>
          <a href={SITE.socials.x} target="_blank" rel="noopener noreferrer me" class="editorial-link">X / Twitter</a>
        </div>
      </div>
    </div>
  </div>
</section>
